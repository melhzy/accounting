__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.DS_Store
.venv/
venv/
env/
*.egg-info/

# Word lockfiles (open .docx files)
~$*.docx
~$*.xlsx

# Unsloth's autogen on first import
unsloth_compiled_cache/

# Training artifacts — large, reproducible from the recipe + data. Per ROADMAP
# version-tracking, the manifest.json/test_metrics.json under each run live in
# the repo by convention, but the adapter weights and checkpoints do not.
# Patterns are two-star to match the host-nested layout:
#   models/runs/{dgx_spark,windows,...}/<run_id>/...
models/runs/**/adapter/
models/runs/**/checkpoints/
models/runs/**/checkpoint-*/
models/runs/**/gguf/
models/runs/**/gguf_*/
models/runs/**/executed_notebook.ipynb
models/runs/**/launch.log*
models/runs/**/README.md
# Trained weights live outside git; reproducibility lives in manifest.json
models/runs/**/adapter_model.safetensors
models/runs/**/tokenizer.json
models/runs/**/training_args.bin

# HF cache (in case someone sets HF_HOME inside the repo)
hf_cache/

# Claude Code harness — per-developer overrides (settings.json is checked in)
.claude/settings.local.json
